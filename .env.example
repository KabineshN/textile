# ── Server-Side Environment Variables (NOT exposed to browser) ──

# Database Connection (MongoDB)
# Local: mongodb://localhost:27017/
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/"

# AI Assistant / Chatbot (Google Gemini API Key)
# Obtain free from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional Alternative AI Providers
# OPENAI_API_KEY=""
# LOVABLE_API_KEY=""

# ── Client-Side Environment Variables (VITE_ prefix = exposed to browser) ──

# Google OAuth (Required for "Continue with Google" sign-in)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized JavaScript origins: http://localhost:8080 (or your production URL)
# Authorized redirect URIs: http://localhost:8080/auth (or your production URL/auth)
VITE_GOOGLE_CLIENT_ID=""
